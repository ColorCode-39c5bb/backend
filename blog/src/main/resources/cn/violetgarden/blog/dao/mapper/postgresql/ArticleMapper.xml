<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.violetgarden.blog.dao.mapper.postgresql.ArticleMapper">
<select id="select_all" parameterType="cn.violetgarden.blog.controller.postgresql.requestbody.ArticleRequestBody" resultType="cn.violetgarden.blog.entity.postgresql.Article">
SELECT * FROM public."Article" WHERE id IN (
	SELECT article_id FROM association."Article_Tag"
	<if test="tags.size()>0">WHERE tag_name IN <foreach collection="tags" item="tag" open="(" close=")" separator=",">#{tag.name}</foreach></if>
)
<if test="keyword.length()>0">AND content LIKE '%'||#{keyword}||'%'</if>
</select>
</mapper>